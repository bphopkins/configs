# Git global configuration, stowed to ~/.config/git/config (the XDG location).
# There is deliberately no ~/.gitconfig on either machine: git reads both files
# and the legacy one wins on conflicts, which is how the two machines drifted
# apart before 2026-09-07. Everything git-global lives in ~/.config/git/.
#
# Identity is NOT here. This repo is public, so [user] name and email live in a
# private include (bottom). Never set them with `git config --global`: that
# command writes straight through the stow symlink into this file (measured
# 2026-09-07), and the next gpushall would publish whatever it set. Edit this
# file in the repo instead.

[user]
	# Refuse to guess an author from the login name and hostname. If the
	# private identity include is absent, commits fail with a clear message
	# instead of going out as bph@<host>.(none). (Git documents this option;
	# the refusal itself was not exercised here.)
	useConfigOnly = true

[url "git@github.com:"]
	# Every https GitHub URL becomes SSH, so a URL pasted from a browser clones
	# and pushes over the key without editing the remote afterwards.
	insteadOf = https://github.com/

[init]
	# The files ref backend for every repository made here, by `init` and by
	# `clone` alike (org/machines/transport-2026-10, rules.md ws-6). Syncthing
	# carries each repository's .git whole between the machines, and what it
	# can deliver half-arrived was measured for the files backend alone;
	# reftable rewrites and deletes its table files at every write, a churn
	# no one has watched cross the hub. Its turn as git's default for new
	# repositories is announced for git 3.0 (Documentation/BreakingChanges),
	# and the machines upgrade on different days, so the backend is named
	# here, once for both. A move to reftable is one decision, taken by
	# changing this line.
	# Test: tests/git-hosts/run.sh.
	defaultRefFormat = files

[include]
	# Private and synced: [user] name and email. Git ignores a missing include
	# silently; useConfigOnly above turns that silence into a refusal.
	path = ~/Desktop/org/claude-config/git/identity

[include]
	# Machine-local: this machine's half of the configuration, one of
	# hosts/<hostname>.inc, through the link ~/.config/git/host.inc made by
	# hand at bootstrap (README section 5) -- fedxps's reader guard,
	# bigfed's writer settings. Git ignores a missing include silently, so a
	# forgotten link leaves fedxps unguarded; the check is
	# `git config --show-origin core.checkStat`, which names host.inc there
	# and nothing on bigfed (2026-10-10, org/machines/transport-2026-10).
	path = ~/.config/git/host.inc
