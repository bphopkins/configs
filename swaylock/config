# swaylock -- stow-managed from ~/Desktop/configs/swaylock/config.
# Edit it here, not at ~/.config/swaylock/config (that is a symlink into this repo).
#
# Why this file exists rather than inline flags: swaylock is invoked from two
# places in sway/config -- the $mod+Ctrl+l binding and swayidle's before-sleep
# hook -- so inline colours would have to be kept in sync by hand. Both call
# sites are a bare `swaylock -f`; everything cosmetic lives here.
#
# Syntax (man 1 swaylock): long option names with no leading dashes, `=` for
# options that take an argument, bare name for flags, and no trailing spaces
# (swaylock keeps them, and a flag with one is unrecognised). Colours are
# RRGGBB or RRGGBBAA. swaylock stops reading this file at the first key it
# does not know and locks with the lines above it; everything below silently
# reverts to its defaults (load_config in main.c, checked 2026-09-30). The
# one line that would mean no lock is `version`, which exits. So keep keys
# verified against `man 1 swaylock`.
#
# Palette is deliberately the same as sway/config's:
#   background #000000   accent (ring) #0088FF   text #ffffff
#   verifying  #5f676a   (client.focused_inactive)
#   wrong      #d08770   (Waybar's @urgent, so a failed unlock reads as the same
#                         signal the bar uses for an urgent window)

# Flat black, the desktop's ground (sway's unfocused window background, the
# bar, the launcher; a fold's strip paints the accent and grey over it since
# 2026-09-29). Deliberately not the wallpaper: a lock screen that depends on a
# file path gains a failure mode for no security benefit.
color=000000

indicator-radius=100
indicator-thickness=8
show-failed-attempts

# An Enter with nothing typed does nothing. Without this it submits an empty
# password: about 2 s of "Verifying" (pam_faildelay), then "Wrong" on the
# orange ring for 3 s, and a failed attempt on the counter (2026-09-30).
ignore-empty-password

# Keep the ring on screen instead of only revealing it on the first keypress.
# Without this a locked machine is indistinguishable from a powered-off one,
# which is disorienting -- you cannot tell the lock is there until you type.
#
# Note this is as far as mainline swaylock goes: it has no clock. The --clock /
# --timestr / --datestr options belong to `swaylock-effects`, a separate fork,
# so showing the actual time would mean replacing the packaged swaylock. Not
# done -- the ring alone answers "is the lock screen up?", which was the point.
# Deliberately no username or session detail on screen either.
indicator-idle-visible

# Idle / typing
ring-color=0088FF
inside-color=000000AA
line-color=00000000
separator-color=00000000
text-color=ffffff
key-hl-color=ffffff
bs-hl-color=d08770

# Verifying the password
ring-ver-color=5f676a
inside-ver-color=000000AA
line-ver-color=00000000
text-ver-color=ffffff

# Wrong password
ring-wrong-color=d08770
inside-wrong-color=000000AA
line-wrong-color=00000000
text-wrong-color=ffffff

# Input cleared -- after Esc, a clearing chord, or the 10-s silent wipe of a
# half-typed password, the case where seeing the word matters most. White:
# upstream's black default was made for its orange clear fill and drew
# "Cleared" black on black here (2026-09-30).
ring-clear-color=ffffff
inside-clear-color=000000AA
line-clear-color=00000000
text-clear-color=ffffff

# Caps Lock is on -- worth shouting about, since it is the usual reason a
# correct password is rejected. The colours below apply only with
# indicator-caps-lock set; without it swaylock showed the words "Caps Lock" on
# the ordinary blue ring and five of these six keys never took effect
# (2026-09-30). The highlights differ from the ring so keypresses still show.
indicator-caps-lock
ring-caps-lock-color=d08770
inside-caps-lock-color=000000AA
line-caps-lock-color=00000000
text-caps-lock-color=ffffff
caps-lock-key-hl-color=ffffff
caps-lock-bs-hl-color=000000
