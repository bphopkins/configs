#!/usr/bin/env bash
# Repaint-shaped throughput, plus the cold/warm distinction that turned out to
# dominate the plain-text numbers. Run INSIDE the terminal under test, one
# terminal at a time, at a controlled grid (README, "Controlling the grid").
#
#   TERM_BENCH_OUT=/path/out.txt repaint-bench
#
# Phases, in this order deliberately:
#   plain COLD    one rep into a terminal that has drawn nothing yet
#   plain warm    best of 3 -- still before the big workload
#   repaint       best of 3 over the captured nvim corpus (capture-nvim)
#   plain WARM    best of 3 *after* the repaint corpus has run
#   plain alt     best of 3 inside the alternate screen (no scrollback)
# The COLD/WARM pair is the point: on 2026-09-05 WezTerm's plain throughput
# improved 2.6x between them while Ghostty's improved 1.4x, which means a
# single cold flood measures warm-up, not steady state.
set -uo pipefail
OUT="${TERM_BENCH_OUT:-}"
CORPUS="${TERM_BENCH_CORPUS:-${TMPDIR:-/tmp}/term-bench-corpus}"
REPAINT="$CORPUS/repaint.bin"
PLAIN="$CORPUS/corpus-plain.txt"
[[ -f $REPAINT ]] || { echo "no $REPAINT -- run capture-nvim first" >&2; exit 1; }
[[ -f $PLAIN   ]] || { echo "no $PLAIN -- run term-bench once to generate it" >&2; exit 1; }

TERM_NAME=unknown; TERM_PID=unknown; p=$PPID
while [[ -n $p && $p -gt 1 ]]; do
  n=$(ps -o comm= -p "$p" 2>/dev/null | tr -d ' ') || break
  case $n in wezterm-gui) TERM_NAME=WezTerm; TERM_PID=$p; break;;
             ghostty) TERM_NAME=Ghostty; TERM_PID=$p; break;; esac
  p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
done
prev=""; stable=0
for _ in $(seq 1 60); do
  cur="$(tput cols)x$(tput lines)"
  [[ $cur == "$prev" ]] && stable=$((stable+1)) || stable=0
  [[ $stable -ge 3 ]] && break
  prev="$cur"; sleep 0.05
done
GRID="$cur"
FRAMES=$(python3 -c "import re,sys;print(len(re.findall(rb'\x1b\[\?2026h',open(sys.argv[1],'rb').read())))" "$REPAINT")
CLK=$(getconf CLK_TCK 2>/dev/null || echo 100)
own(){ [[ $TERM_PID =~ ^[0-9]+$ ]] || { echo 0; return; }
  local r; r=$(sed 's/.*) //' "/proc/$TERM_PID/stat" 2>/dev/null) || { echo 0; return; }
  awk -v hz="$CLK" '{printf "%d",($12+$13)*1000/hz}' <<<"$r"; }
rss(){ [[ $TERM_PID =~ ^[0-9]+$ ]] || { echo 0; return; }
  awk '/^VmRSS/{print $2}' "/proc/$TERM_PID/status" 2>/dev/null || echo 0; }

# NOTE: run/run1 set $RESULT. They must NEVER be called in a command
# substitution -- that sends cat down a pipe and the corpus never reaches the
# terminal at all (README trap 1, which bit again on 2026-09-05).
RESULT=""
run1(){ local c0 c1 t0 t1
  c0=$(own); t0=$(date +%s%N); cat "$2"; t1=$(date +%s%N); c1=$(own)
  RESULT=$(printf '    %-22s wall %6s ms   termcpu %6s ms' "$1" "$(( (t1-t0)/1000000 ))" "$(( c1-c0 ))"); }
run(){ local best=99999999 bcpu=0 c0 c1 t0 t1 ms
  for _ in 1 2 3; do
    c0=$(own); t0=$(date +%s%N)
    if [[ ${3:-0} == 1 ]]; then printf '\033[?1049h'; cat "$2"; printf '\033[?1049l'
    else cat "$2"; fi
    t1=$(date +%s%N); c1=$(own)
    ms=$(( (t1-t0)/1000000 )); (( ms<best )) && { best=$ms; bcpu=$(( c1-c0 )); }
  done
  RESULT=$(printf '    %-22s wall %6s ms   termcpu %6s ms' "$1" "$best" "$bcpu"); }

R0=$(rss)
run1 "plain COLD (1 rep)" "$PLAIN";        rows="$RESULT"$'\n'
run  "plain warm (bo3)"   "$PLAIN";        rows+="$RESULT"$'\n'
run  "repaint (bo3)"      "$REPAINT";      rows+="$RESULT"$'\n'
R1=$(rss)
run  "plain WARM (bo3)"   "$PLAIN";        rows+="$RESULT"$'\n'
run  "plain alt (bo3)"    "$PLAIN" 1;      rows+="$RESULT"$'\n'
R2=$(rss)
clear
SUM=$(printf '  terminal: %s   grid %s   repaint frames: %s\n%s' "$TERM_NAME" "$GRID" "$FRAMES" "$rows")
SUM+=$(printf '  rss: %s -> %s (through repaint) -> %s KiB (through plain)\n' "$R0" "$R1" "$R2")
printf '%s\n' "$SUM"
[[ -n $OUT ]] && printf '%s\n' "$SUM" >> "$OUT"
exit 0
