def env_seconds(name, default):
    """A positive number of seconds from the environment, else the default."""
    try:
        v = float(os.environ.get(name, default))
    except ValueError:
        return default
    return v if v > 0 else default


SETTLE = env_seconds("SYNC_CHECK_SETTLE", 15.0)
POLL = env_seconds("SYNC_CHECK_POLL", 3.0)
REST_TIMEOUT = 20
SCAN_TIMEOUT = 600
SSH_HUB_TIMEOUT = 8
SSH_PEER_TIMEOUT = 4
# What a remote command may take beyond its connect budget; the whole attempt
# at one host, both doors together, ends at budget + this (the suite shortens it).
SSH_GRACE = env_seconds("SYNC_CHECK_SSH_GRACE", 30.0)
# The LAN door answers in 0.3 s at home and hangs to its timeout away from it
# (pilot/verdict.md -> D1); 2 s keeps a run away from home inside the session
# hook's 4 s once the tailnet door answers (settled 39).
FIRST_DOOR_TIMEOUT = 2
