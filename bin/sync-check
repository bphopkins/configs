# modified it, so the vector check (fedxps-3's durable form) would FAIL on an
# explained write forever after. Each: the machine that wrote, the folder's
# label, the path in the folder, the counter its write left, when it was
# found, and the record. A path whose counter is other than the one named
# FAILs as a new write. Delete a line once the path no longer shows.
KNOWN_WRITES = [
]

