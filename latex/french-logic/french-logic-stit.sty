\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{french-logic-stit}[2026/09/08 french-logic: STIT]
%% The STIT vocabulary: structure names and operators in tracked italics, through
%% \versal.  Ordered 2026-09-08; every definition is as it was.
%% microtype without options, the tracking set afterwards: the same output (measured
%% pixel-identical), and no option clash when a document loads microtype itself first
%% (D16).
\RequirePackage{microtype}
\microtypesetup{tracking=smallcaps}

%%% Helper %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% \versal: letterspaced by -30 units, the house form for these names.
\newcommand{\versal}[1]{{\textls*[-30]{#1}}}

%%% Structures %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\tree}{\versal{\textit{Tree}}}
\newcommand{\agent}{\versal{\textit{Agent}}}
\newcommand{\choice}{\versal{\textit{Choice}}}
\newcommand{\stitought}{\versal{\textit{Ought}}}
\newcommand{\stitval}{\versal{\textit{Value}}}
\newcommand{\choicema}{\versal{\textit{Choice}}_\alpha^m}

%%% Operators %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\cstit}[2]{[#1\:\versal{\textit{cstit}}\colon #2]}
\newcommand{\dstit}[2]{[#1\:\versal{\textit{dstit}}\colon #2]}
\newcommand{\cstito}{\versal{\textit{cstit}}}
\newcommand{\dstito}{\versal{\textit{dstit}}}
\newcommand{\stit}{\versal{\textit{stit}}}
