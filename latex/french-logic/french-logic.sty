\ProvidesPackage{french-logic}[2026/09/08 v1.0 Semantic markup for logic]

%% french-logic is a hub.  The language lives in the unit packages below, each with
%% its own dependencies at its head; users load only this file.  The map is
%% README.md beside it, the inventory AUDIT.md; run tests/french-logic/run.sh after
%% any edit.  french-logic-quarry.sty is never loaded: retired explorations, kept.

%%% Options %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% One switch per unit, default on.  [structure=false,cite=false] for a host class
%% that owns theorems, hyperlinks, and the bibliography driver; [preamble=false] for
%% one that owns fonts and layout.  Bundles:
%%   deon = structure=false, cite=false      (the DEON template; beamer)
%%   slim = deon, preamble=false             (a class that owns fonts and layout too)
%% Keys apply in the order given, so [deon,structure=true] turns structure back on.
%% An unknown option is an error, not a warning.  \iffrenchlogicdeon is kept for
%% anything that tested it: true when deon or slim was given.
\newif\iffrenchlogicdeon
\newif\iffrenchlogic@preamble \frenchlogic@preambletrue
\newif\iffrenchlogic@core \frenchlogic@coretrue
\newif\iffrenchlogic@applied \frenchlogic@appliedtrue
\newif\iffrenchlogic@deontic \frenchlogic@deontictrue
\newif\iffrenchlogic@modal \frenchlogic@modaltrue
\newif\iffrenchlogic@conditional \frenchlogic@conditionaltrue
\newif\iffrenchlogic@io \frenchlogic@iotrue
\newif\iffrenchlogic@stit \frenchlogic@stittrue
\newif\iffrenchlogic@gentzen \frenchlogic@gentzentrue
\newif\iffrenchlogic@diagrams \frenchlogic@diagramstrue
\newif\iffrenchlogic@lists \frenchlogic@liststrue
\newif\iffrenchlogic@structure \frenchlogic@structuretrue
\newif\iffrenchlogic@cite \frenchlogic@citetrue
\newif\iffrenchlogic@proof \frenchlogic@prooftrue
\DeclareKeys[french-logic]{
  preamble.if = frenchlogic@preamble,
  core.if = frenchlogic@core,
  applied.if = frenchlogic@applied,
  deontic.if = frenchlogic@deontic,
  modal.if = frenchlogic@modal,
  conditional.if = frenchlogic@conditional,
  io.if = frenchlogic@io,
  stit.if = frenchlogic@stit,
  gentzen.if = frenchlogic@gentzen,
  diagrams.if = frenchlogic@diagrams,
  lists.if = frenchlogic@lists,
  structure.if = frenchlogic@structure,
  cite.if = frenchlogic@cite,
  proof.if = frenchlogic@proof,
  deon.code = {\frenchlogicdeontrue\frenchlogic@structurefalse\frenchlogic@citefalse},
  slim.code = {\frenchlogicdeontrue\frenchlogic@structurefalse\frenchlogic@citefalse\frenchlogic@preamblefalse},
}
\ProcessKeyOptions[french-logic]

%% beamer owns theorems and hyperref, which the structure unit would load again.
%% Refuse loudly rather than let hyperref's option clash speak for us.
\@ifclassloaded{beamer}{\iffrenchlogic@structure
  \PackageError{french-logic}{beamer owns theorems and hyperref,\MessageBreak
    which the structure unit would load again}{Load french-logic with [deon],\MessageBreak
    or with [structure=false] (add cite=false if the deck loads biblatex itself).}\fi}{}

%%% Units, in the layered order of README.md %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\iffrenchlogic@preamble\RequirePackage{french-logic-preamble}\fi% fonts, encodings, babel, conveniences
\iffrenchlogic@core\RequirePackage{french-logic-core}\fi% symbols, sets, syntax, relations, structures, semantics, metalanguage
\iffrenchlogic@applied\RequirePackage{french-logic-applied}\fi% temporal, epistemic, credence
\iffrenchlogic@deontic\RequirePackage{french-logic-deontic}\fi% O, P, F and the dyadic operators
\iffrenchlogic@modal\RequirePackage{french-logic-modal}\fi% names of axioms, rules, systems
\iffrenchlogic@conditional\RequirePackage{french-logic-conditional}\fi% CM/CC families and their frame conditions
\iffrenchlogic@io\RequirePackage{french-logic-io}\fi% input/output logic
\iffrenchlogic@stit\RequirePackage{french-logic-stit}\fi% STIT
\iffrenchlogic@gentzen\RequirePackage{french-logic-gentzen}\fi% proof trees
\iffrenchlogic@diagrams\RequirePackage{french-logic-diagrams}\fi% possible-worlds diagrams
\iffrenchlogic@lists\RequirePackage{french-logic-lists}\fi% list environments, block, \by
\iffrenchlogic@structure\RequirePackage{french-logic-structure}\fi% hyperref, cleveref, theorem and proof environments
\iffrenchlogic@cite\RequirePackage{french-logic-cite}\fi% biblatex and the citation forms
\iffrenchlogic@proof\RequirePackage{french-logic-proof}\fi% end-of-proof mark (loads last: needs to see amsthm), consequence frameworks
