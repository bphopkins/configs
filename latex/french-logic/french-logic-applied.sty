\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{french-logic-applied}[2026/09/08 french-logic: applied modal operators: temporal, epistemic, credence]
%% Deontic modals are applied modals too; the categories are practical, not a taxonomy
%% (README, Architecture).  The operator letters are sans, in double braces: the inner
%% pair is the placeholder for a future bold switch (to make an operator bold, put
%% \textbf before it).  Ordered 2026-09-08; every definition is as it was.

%%% Temporal %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\hitherto}{\mathsf{{H}}}
\newcommand{\henceforth}{\mathsf{{G}}}
\newcommand{\was}{\mathsf{{P}}}
\newcommand{\willbe}{\mathsf{{F}}}
\newcommand{\precedes}{\prec}

%%% Epistemic %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Knowledge and belief, with an agent index or bare, in capital and lowercase forms.
\newcommand{\knows}[1]{\mathsf{{K}}_{#1}}
\newcommand{\know}{\mathsf{{K}}}
\newcommand{\cknows}[1]{\mathsf{{k}}_{#1}}
\newcommand{\cknow}{\mathsf{{k}}}
\newcommand{\believes}[1]{\mathsf{{B}}_{#1}}
\newcommand{\believe}{\mathsf{{B}}}
\newcommand{\cbelieves}[1]{\mathsf{{b}}_{#1}}
\newcommand{\cbelieve}{\mathsf{{b}}}

%%% Credence %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Conditional probability and credence, in bold roman letters.
\newcommand{\cprob}[2]{\textbf{P}({{#1} \mid {#2}})}
\newcommand{\cred}[1]{\textbf{C}(#1)}
\newcommand{\ccred}[2]{\textbf{C}({{#1} \mid {#2}})}
