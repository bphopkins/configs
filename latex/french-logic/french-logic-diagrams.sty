\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{french-logic-diagrams}[2026/09/08 french-logic: TikZ styles for possible-worlds diagrams]
%% No members: the styles are keys, so the rendering suite covers them through its
%% extras page (tests/french-logic/extras.tex).  Ordered 2026-09-08; every key is as
%% it was.  A reference for the drawing idiom:
%% http://www.actual.world/resources/tex/doc/TikZ.pdf
\RequirePackage{tikz}
\RequirePackage{tikzsymbols}
\usetikzlibrary{arrows,calc,patterns,positioning,shapes}

%%% Styles %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% modal for the picture (the stealth' tip is kept, D2), world and point for the
%% nodes, and the reflexive loops by side, each with its looseness as default.
\tikzset{
  modal/.style={>=stealth',shorten >=1pt,shorten <=1pt,auto,node distance=1.5cm,semithick},
  world/.style={circle,draw,minimum size=1cm,fill=gray!15},
  point/.style={circle,draw,fill=black,inner sep=0.5mm},
  reflexive above/.style={->,loop,in=120,out=60,looseness=#1},
  reflexive above/.default={7},
  reflexive/.style={reflexive above=#1},% the same loop with a tighter default
  reflexive/.default={5},
  reflexive point/.style={->,in=135,out=45,loop,looseness=#1},
  reflexive point/.default={25},
  reflexive below/.style={->,loop,in=240,out=300,looseness=#1},
  reflexive below/.default={7},
  reflexive left/.style={->,loop,in=150,out=210,looseness=#1},
  reflexive left/.default={7},
  reflexive right/.style={->,loop,in=30,out=330,looseness=#1},
  reflexive right/.default={7}
}
