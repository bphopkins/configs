\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{french-logic-lists}[2026/09/07 french-logic: list environments, block, and right-margin annotations]

\RequirePackage{enumitem}

% block: an indented display for quoted formulations.  Outside the amsthm guard
% because it needs nothing from it; skipped where a class (beamer) already owns
% an environment of that name.
\@ifundefined{block}{%
  \newenvironment{block}{\begin{list}{}{\setlength{\leftmargin}{2em}%
    \setlength{\rightmargin}{0em}}\item[]}{\end{list}}%
}{\PackageInfo{french-logic}{Environment block already defined by the class; not redefined}}

% List Environments
% Under beamer, enumitem's and beamer's enumerate.sty \labelenumi redefinitions
% chain into a recursion (TeX capacity exceeded, grouping levels).  Setting the
% enumerate defaults through enumitem's own mechanism breaks the chain; the
% completeness deck carried these four lines itself before the package did.
\@ifclassloaded{beamer}{%
  \setlist[enumerate,1]{label=\arabic*.}%
  \setlist[enumerate,2]{label=(\alph*)}%
  \setlist[enumerate,3]{label=\roman*.}%
  \setlist[enumerate,4]{label=\Alph*.}%
}{}
\newenvironment{hilbertlist}{\begin{itemize}[topsep=8pt,noitemsep,labelsep=1.5em,leftmargin=2cm,rightmargin=1.25cm]}{\end{itemize}}
\newenvironment{romanlist}{\begin{enumerate}[label=(\roman*),topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{Romanlist}{\begin{enumerate}[label=(\Roman*),topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{arablist}{\begin{enumerate}[label={\arabic*.},topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{arablistpar}{\begin{enumerate}[label=(\arabic*),topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{alphlistpar}{\begin{enumerate}[label=(\alph*),topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{Alphlist}{\begin{enumerate}[label={\Alph*.},topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{enumerate}}
\newenvironment{itemlist}{\begin{itemize}[topsep=8pt,noitemsep,leftmargin=1.25cm]}{\end{itemize}}
\newenvironment{itemlistflush}{\begin{itemize}[topsep=8pt,noitemsep,leftmargin=1cm]}{\end{itemize}}
\newenvironment{axiomproof}{\begin{enumerate}[label=(\arabic*),topsep=8pt,noitemsep,leftmargin=1.25cm,rightmargin=1.25cm]}{\end{enumerate}}
\newcommand{\by}[1]{\hfill\textnormal{#1}}
