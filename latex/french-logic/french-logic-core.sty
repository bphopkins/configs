\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{french-logic-core}[2026/09/08 french-logic: core notation: symbols, sets, syntax, relations, structures, functions, semantics, metalanguage]
%% The tower, top to bottom: symbols, sets, syntax, relations, structures, functions,
%% semantics, the metalanguage.  Every other unit refers into this one; it refers into
%% nothing.  Ordered by the tower since 2026-09-08, every definition as it was; the same
%% day \mcslog lost its forced trailing space, \unneced a kern run summing to zero, and
%% \emptytruthset its two kerns (the open dot read better on the confirmation pass).
%% On the sixth sitting the ten decorated sets (\truthsetm and kin, \proofsetl, \eclassl)
%% got back the tuck the scaling conversion had dropped, as \mkern-3mu inside the script.
%% Comment grammar, shared by the units: a %%% line opens a level of the tower, a
%% short % line names a group within it (the inventory's headings), %% is prose.
% soul: \st below is a renewal of its strikeout command; trimclip: \clipbox in
% \natent; graphicx: \scalebox and \rotatebox in the closure arrows and \nnatent.
\RequirePackage{soul}
\RequirePackage{trimclip}
\RequirePackage{graphicx}

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}
\RequirePackage{stmaryrd}
\RequirePackage{mathrsfs}
\RequirePackage{xspace}
\xspaceaddexceptions{/}

%%% Helpers %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The small letter on a name (the R of CM_R, the H of IO^H): upright, at
%% \scriptscriptstyle, so it scales with the mathematics around it -- smaller in a
%% footnote, larger in a heading, the floor size when nested.  Settled 2026-09-07 by
%% eye against the fixed-size idioms.  Internal: documents never type it.
\newcommand{\fl@lbl}[1]{{\scriptscriptstyle\mathrm{#1}}}
%% In PDF bookmarks (hyperref, if a document loads it) the label is its bare letter.
\AtBeginDocument{\@ifpackageloaded{hyperref}{\pdfstringdefDisableCommands{\def\fl@lbl#1{#1}}}{}}

%%% Symbols %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Glyphs drawn from symbol fonts, and the two built by hand.
%% \Yright is the sequent separator (\seq, \tseq): Humberstone's convention.  stmaryrd
%% already declares it at this slot; the declaration is kept here as the record (D5).
\DeclareMathSymbol{\Yright}{\mathbin}{stmry}{"07}
%% \shortminus backs the inverse-image forms \unneced and \unpossed.
\DeclareMathSymbol{\shortminus}{\mathbin}{AMSa}{"39}
%% The strict conditional is txfonts' fishhook, declared from its own font.
\DeclareFontFamily{U}{txsyc}{}
\DeclareFontShape{U}{txsyc}{m}{n}{<->txsyc}{}
\DeclareSymbolFont{txsycfont}{U}{txsyc}{m}{n}
\DeclareMathSymbol{\strictif}{\mathrel}{txsycfont}{74}
%% The double bar of \ctruthset, and parentheses around a name that has no par form.
\newcommand{\dvbar}{{{\mbox{$|\mkern-3.7mu|$}}}}
\newcommand{\parent}[1]{(#1)}

%%% Sets %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The mathematical vernacular every level uses: sets, tuples, the powerset, the
%% definitional idiom, and the order-theoretic arrows.
\newcommand{\set}[1]{\{#1\}}
\newcommand{\oset}[1]{\langle #1 \rangle}
\newcommand{\tuple}[1]{\langle #1 \rangle}
\newcommand{\inclin}{\sqsubseteq}
\newcommand{\power}[1]{\wp(#1)}
\renewcommand{\emptyset}{\varnothing}
\newcommand{\intersect}{\cap}
\newcommand{\union}{\cup}
\newcommand{\suchthat}{\colon}
\renewcommand{\st}{\textnormal{ s.t. }}
\newcommand{\defby}{\,\mathrel{\raisebox{.25pt}{\mbox{:$\mkern-1.5mu$:}}\mbox{$\mkern-1.5mu$=}}\,}
\newcommand{\defbyvar}{\:=_\textnormal{def}\:}
\newcommand{\filter}{\uparrow\!\!}
\newcommand{\topg}{\Uparrow_\textnormal{G}}
\newcommand{\botg}{\Downarrow_\textnormal{G}}
\newcommand{\topa}{\Uparrow_\textnormal{A}}
\newcommand{\bota}{\Downarrow_\textnormal{A}}

%%% Syntax %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The object language and its proof theory: languages and logics, the connectives,
%% the consequence and closure operators, proof sets and classes of formulas.

% Syntax: languages and logics
\newcommand{\Fm}{\textsf{Fm}}
\newcommand{\props}{{\mathcal{P}}}
\newcommand{\atoms}{\textsf{At}}
\newcommand{\pzero}{{p_0}}
\newcommand{\pone}{{p_1}}
\newcommand{\ptwo}{{p_2}}
\newcommand{\pthree}{{p_3}}
\newcommand{\lang}{\ensuremath{\mathscr{L}}\xspace}
\newcommand{\langp}{\ensuremath{\mathscr{L}^{\fl@lbl{P}}}\xspace}
\newcommand{\langm}{\ensuremath{\mathscr{L}^{\fl@lbl{M}}}\xspace}
\newcommand{\langd}{\ensuremath{\mathscr{L}^{\fl@lbl{D}}}\xspace}
\newcommand{\langmd}{\ensuremath{\mathscr{L}^{\fl@lbl{MD}}}\xspace}
\newcommand{\langc}{\ensuremath{\mathscr{L}^{\fl@lbl{C}}}\xspace}
\newcommand{\logic}{\mathcal{L}}
\newcommand{\logicp}{\logic_{\!\fl@lbl{p}}}
\newcommand{\metalogic}{\ensuremath{\mathcal{ML}}\xspace}% the metalanguage, in \logic's script; use instead of a literal "ML"
% Syntax: connectives
\renewcommand{\iff}{\leftrightarrow}
\newcommand{\onlyif}{\rightarrow}
\newcommand{\then}{\rightarrow}
\renewcommand{\to}{\rightarrow}% the kernel's already; renewed to declare \to a member with its house form
\newcommand{\minus}{{\sim}}
\newcommand{\nec}{\Box}
\newcommand{\poss}{{\Diamond}}
%% The conjunction of a set of sentences, tight, and the same wedge with negative kerns.
\newcommand{\tightwedge}{\mathbin{\mkern-1mu\wedge\mkern-1mu}}
\newcommand{\wedgeset}{\!\wedge\!}
% Syntax: consequence and closure
\newcommand{\cn}[1]{\textnormal{Cn}(#1)}
\newcommand{\theory}[1]{\mathcal{T}_{#1}}
\newcommand{\Cl}[2]{\textnormal{\textup{Cl}}_{#1}(#2)}
\newcommand{\mcslog}{\textsf{mcs}_{\logic}}
% Syntax: proof sets and classes
\newcommand{\proofset}[1]{[#1]}
\newcommand{\proofsetl}[1]{[#1]_{{\mkern-3mu\scriptscriptstyle \logic}}}
\newcommand{\eclass}[1]{|#1|}
\newcommand{\eclassl}[1]{|#1|_{{\mkern-3mu\scriptscriptstyle \logic}}}
\newcommand{\mcseti}[2]{|#2|_{#1}}

%%% Relations %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Consequence and satisfaction as bare relation symbols, with their indexed forms,
%% the sequent arrows, the turnstile interface glyphs, and bisimulation.  The
%% model-relative forms (M models A; M, w forces A) are under Semantics.
\newcommand{\derives}{\Rightarrow}
\newcommand{\gives}{\vdash}
\newcommand{\asserts}{\vdash}
\newcommand{\proves}{\vdash}
\newcommand{\nproves}{\nvdash}
\newcommand{\provesrel}[1]{\proves_{\!\mathscr{#1}}}
\renewcommand{\models}{\vDash}
\newcommand{\nmodels}{\nvDash}
\newcommand{\modelsrel}[1]{\models_{\!\mathscr{#1}}}
\newcommand{\trues}{\Vdash}
\newcommand{\ntrues}{\nVdash}
\newcommand{\seq}{\;\Yright\;}
\newcommand{\tseq}{\Yright\;}
\newcommand{\ent}{{\:\:^\vdash\!\!/\!_\vDash\:}}
\newcommand{\natent}{%
\mathrel{\text{\clipbox{0pt 0pt {.8\width} 0pt}{$\Vdash$}}\mkern.9mu}\vDash
}
\newcommand{\nnatent}{{\natent\!\!\!\!\!\!\!\!\!\; \raisebox{1.25pt}{\rotatebox[origin=c]{-50}{|}}}}
\newcommand{\bisim}{\leftrightarroweq}

%%% Structures %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Models, frames, classes and algebras in fraktur, with their indexed and decorated
%% forms; the canonical model and its components; the closure arrows on them.

% Structures: models, frames, classes, algebras
\newcommand{\M}{\mathfrak{M}}
\newcommand{\F}{\mathfrak{F}}
\newcommand{\C}{\mathfrak{C}}
\newcommand{\A}{\mathfrak{A}}
\newcommand{\R}{\mathcal{R}}
%% The index letter is the relation or function itself (F_R is <W, R>), so it is an
%% italic math letter; settled 2026-09-07.
\newcommand{\FR}{\mathfrak{F}_{\!\scriptscriptstyle R}}
\newcommand{\FRtwo}{\mathfrak{F}_{\!\scriptscriptstyle R}^{\scriptscriptstyle 2}}
\newcommand{\FRthree}{\mathfrak{F}_{\!\scriptscriptstyle R}^{\scriptscriptstyle 3}}
\newcommand{\FN}{\mathfrak{F}_{\!\scriptscriptstyle N}}
\newcommand{\FNone}{\mathfrak{F}_{\!\scriptscriptstyle N}^{\scriptscriptstyle 1}}
\newcommand{\FNtwo}{\mathfrak{F}_{\!\scriptscriptstyle N}^{\scriptscriptstyle 2}}
\newcommand{\MR}{\mathfrak{M}_{\!\scriptscriptstyle R}}
\newcommand{\MN}{\mathfrak{M}_{\!\scriptscriptstyle N}}
\newcommand{\MNone}{\mathfrak{M}_{\!\scriptscriptstyle N}^{\scriptscriptstyle 1}}
\newcommand{\MNtwo}{\mathfrak{M}_{\!\scriptscriptstyle N}^{\scriptscriptstyle 2}}
\newcommand{\mwrv}{\M=\oset{W,R,V}}
\newcommand{\mwrp}{\M=\oset{W,R,P}}
\newcommand{\mwnv}{\M=\oset{W,N,V}}
\newcommand{\mwnp}{\M=\oset{W,N,P}}
\newcommand{\Msig}{\M^{{\scriptscriptstyle\Sigma}}}
\newcommand{\Wsig}{W^{{\scriptscriptstyle\Sigma}}}
\newcommand{\Rsig}{R^{{\scriptscriptstyle\Sigma}}}
\newcommand{\Vsig}{V^{{\scriptscriptstyle\Sigma}}}
% Structures: canonical models
\newcommand{\Mlog}{\M^{{\scriptscriptstyle\logic}}}
\newcommand{\Wlog}{W^{{\scriptscriptstyle\logic}}}
\newcommand{\Rlog}{R^{{\scriptscriptstyle\logic}}}
\newcommand{\flog}{f^{{\scriptscriptstyle\logic}}}
\newcommand{\Vlog}{V^{{\scriptscriptstyle\logic}}}
% Structures: canonical models with closures
%% A model and its function decorated with a closure arrow, by direction.
%% Northeast (45 degrees):
\newcommand{\Mne}{\M^{\raisebox{-0.4ex}{\scalebox{0.6}{\rotatebox{45}{$\rightarrow$}}}}}
\newcommand{\fne}{f^{\raisebox{-0.4ex}{\scalebox{0.6}{\rotatebox{45}{$\rightarrow$}}}}}
%% Northwest (135 degrees):
\newcommand{\Mnw}{\M^{\raisebox{-0.4ex}{\scalebox{0.6}{\rotatebox{135}{$\rightarrow$}}}}}
\newcommand{\fnw}{f^{\raisebox{-0.4ex}{\scalebox{0.6}{\rotatebox{135}{$\rightarrow$}}}}}
%% Southeast (315 degrees):
\newcommand{\Mse}{\M^{\raisebox{-0.6ex}{\scalebox{0.6}{\rotatebox{-45}{$\rightarrow$}}}}}
\newcommand{\fse}{f^{\raisebox{-0.6ex}{\scalebox{0.6}{\rotatebox{-45}{$\rightarrow$}}}}}
%% Southwest (225 degrees):
\newcommand{\Msw}{\M^{\raisebox{-0.5ex}{\scalebox{0.6}{\rotatebox{-135}{$\rightarrow$}}}}}
\newcommand{\fsw}{f^{\raisebox{-0.5ex}{\scalebox{0.6}{\rotatebox{-135}{$\rightarrow$}}}}}
%% Northeast/southwest, bidirectional:
\newcommand{\Mlr}{\M^{\raisebox{-0.5ex}{\scalebox{0.6}{\rotatebox{45}{$\leftrightarrow$}}}}}
\newcommand{\flr}{f^{\raisebox{-0.5ex}{\scalebox{0.6}{\rotatebox{45}{$\leftrightarrow$}}}}}

%%% Functions %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The functions of a frame, f_N, f_M, f_D, f_S, f_R, the generic \fsub, and the two
%% applied forms.  The index letter is italic, as on the frames above.
\newcommand{\fn}{{f_{{\mkern-3.6mu\scriptscriptstyle N}}}}
\newcommand{\fm}{{f_{{\mkern-3.6mu\scriptscriptstyle M}}}}
\newcommand{\fd}{{f_{{\mkern-3.6mu\scriptscriptstyle D}}}}
\newcommand{\fs}{{f_{{\mkern-3mu\scriptscriptstyle S}}}}
\newcommand{\fr}{{f_{{\mkern-3.6mu\scriptscriptstyle R}}}}
\newcommand{\fsub}[1]{{f_{{\mkern-3.5mu\scriptscriptstyle #1}}}}
\newcommand{\fsof}[2]{\fs(#1,#2)}
\newcommand{\fnof}[1]{\fn(#1)}

%%% Semantics %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% Valuations and truth values, satisfaction in a model, truth sets with their
%% decorations, and the operations on propositions.

% Semantics: valuations and truth values
\newcommand{\val}[1]{v(#1)}
\newcommand{\vw}[2]{v_{#1}(#2)}
\newcommand{\Val}[1]{\textnormal{Val}(#1)}
\newcommand{\true}{\textnormal{T}}
\newcommand{\false}{\textnormal{F}}
\newcommand{\ind}{\textnormal{i}}
% Semantics: satisfaction in a model
\newcommand{\mmodels}{\M\models}
\newcommand{\mnmodels}{\M\nmodels}
\newcommand{\mtruesat}[1]{\M,{#1}\trues}
\newcommand{\mntruesat}[1]{\M,{#1}\ntrues}
% Semantics: truth sets
%% The decorations (the model, the canonical model, a subscript) sit at the scaling
%% size, judged on the board 2026-09-07.
\newcommand{\truthset}[1]{\llbracket #1\rrbracket}
\newcommand{\truthsetm}[1]{\llbracket #1\rrbracket^{{\mkern-3mu\scriptscriptstyle \M}}}
\newcommand{\truthsetml}[1]{\llbracket #1\rrbracket^{{\mkern-3mu\scriptscriptstyle \M^{\logic}}}}
\newcommand{\truthsetmsub}[2]{\llbracket #1\rrbracket_{{\mkern-3mu\scriptscriptstyle #2}}^{{\mkern-3mu\scriptscriptstyle \M}}}
\newcommand{\truthsetmm}[1]{\llbracket #1\rrbracket_{{\mkern-3mu\scriptscriptstyle m}}^{{\mkern-3mu\scriptscriptstyle \M}}}
\newcommand{\emptytruthset}{\truthset{\cdot}}
\newcommand{\ctruthset}[1]{\dvbar #1\dvbar}
\newcommand{\ctruthsetm}[1]{\dvbar #1\dvbar^{{\mkern-3mu\scriptscriptstyle \M}}}
\newcommand{\ctruthsetml}[1]{\dvbar #1\dvbar^{{\mkern-3mu\scriptscriptstyle \M^{\logic}}}}
\newcommand{\ctruthsetmsub}[2]{\dvbar #1\dvbar_{{\mkern-3mu\scriptscriptstyle #2}}^{{\mkern-3mu\scriptscriptstyle \M}}}
\newcommand{\ctruthsetmm}[1]{\dvbar #1\dvbar_{{\mkern-3mu\scriptscriptstyle m}}^{{\mkern-3mu\scriptscriptstyle \M}}}
% Semantics: operations on propositions
%% The box and the diamond applied to a proposition, and their inverse images.
\newcommand{\neced}{\nec}
\newcommand{\unneced}{\nec^{{{\shortminus\! 1}}}}
\newcommand{\possed}{\poss}
\newcommand{\unpossed}{\poss^{{{\!\shortminus\! 1}}}}

%%% Metalanguage %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% The underlined first-order metalanguage of neighbourhood semantics: the
%% connectives with their spacing, the quantifiers, and the solo forms.
\newcommand{\mland}{\;\mathrel{\underline{\land}}\;}
\newcommand{\mlor}{\;\mathrel{\underline{\lor}}\;}
\newcommand{\mlnot}{\mathord{\underline{\lnot}}}
\newcommand{\mlto}{\enspace\mathrel{\underline{\longrightarrow}}\enspace}
\newcommand{\mlforall}{\mathord{\underline{\forall}}}
\newcommand{\mlexists}{\mathord{\underline{\exists}}}
%% Solo forms: the bare symbols, without connective spacing, for MENTIONING a
%% metalanguage connective rather than USING it (cf. \cnecs vs. \cnecsolo).  Use
%% these when the connectives are named or listed; use the plain forms above when
%% they actually connect (e.g. in frame conditions).
\newcommand{\mltosolo}{\mathord{\underline{\longrightarrow}}}
\newcommand{\mlandsolo}{\mathord{\underline{\land}}}
\newcommand{\mlorsolo}{\mathord{\underline{\lor}}}
\newcommand{\mlnotsolo}{\mathord{\underline{\lnot}}}
\newcommand{\mlforallsolo}{\mathord{\underline{\forall}}}
\newcommand{\mlexistssolo}{\mathord{\underline{\exists}}}
