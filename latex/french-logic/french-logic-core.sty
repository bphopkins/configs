% Misc Preliminary
% The small letter on a name (the R of CM_R, the H of IO^H): upright, at
% \scriptscriptstyle, so it scales with the mathematics around it -- smaller in a
% footnote, larger in a heading, the floor size when nested.  Settled 2026-09-07 by
% eye against the fixed-size idioms.  Internal: documents never type it.
\newcommand{\fl@lbl}[1]{{\scriptscriptstyle\mathrm{#1}}}
% In PDF bookmarks (hyperref, if a document loads it) the label is its bare letter.
\AtBeginDocument{\@ifpackageloaded{hyperref}{\pdfstringdefDisableCommands{\def\fl@lbl#1{#1}}}{}}
% \Yright is the sequent separator (\seq, \tseq): Humberstone's convention. stmaryrd
% already declares it at this slot; the declaration is kept here as the record.
\DeclareMathSymbol{\Yright}{\mathbin}{stmry}{"07}
\DeclareMathSymbol{\shortminus}{\mathbin}{AMSa}{"39}
\newcommand{\dvbar}{{{\mbox{$|\mkern-3.7mu|$}}}}
\newcommand{\parent}[1]{(#1)}

