/* rofi -- stow-managed from ~/Desktop/configs/rofi/theme.rasi.
   Edit it here, not at ~/.config/rofi/theme.rasi (that is a symlink into
   this repo). Loaded by config.rasi's `@theme "theme"`, which discards
   rofi's built-in theme first: without that, the built-in sheet bled
   through a partial one as cream rows, striped lines and a dashed rule
   (rendered 2026-09-30), since its per-widget colours outrank a `*` rule.
   So every widget rofi draws is named here, in the desktop's palette:
   black, white, the muted grey of an unfocused row, the one accent
   (sway's dodger blue, Waybar's and wofi's too) and Source Code Pro, with
   a 3px accent border and no rounding, as wofi/style.css has them. Syntax
   and widget names: man 5 rofi-theme. Check a change with
   `rofi -config rofi/config.rasi -dump-theme` (no display needed), which
   tests/desktop/run.sh runs after edits. */

* {
    bg:      #000000;
    fg:      #ffffff;
    muted:   #9e9e9e;
    accent:  #0088FF;   /* the desktop's one accent (2026-09-29) */
    forest:  #228B22;   /* the former accent, kept for a one-word swap */
    wash:    #0088FF2E; /* the accent at 18 percent: the selected row */

    background-color: @bg;
    text-color:       @fg;
    font:             "Source Code Pro 10";
    border-radius:    0px;
    spacing:          0px;
    margin:           0px;
    padding:          0px;
}

window {
    location:         center;
    anchor:           center;
    width:            520px;
    border:           3px solid;
    border-color:     @accent;
    padding:          10px;
    background-color: @bg;
}

mainbox {
    children:         [ inputbar, listview ];
    spacing:          8px;
    background-color: @bg;
}

/* The search field: the bottom rule is the affordance, as in wofi. */
inputbar {
    children:         [ entry ];
    border:           0px 0px 2px 0px;
    border-color:     @muted;
    padding:          6px 4px;
    background-color: @bg;
}

entry {
    placeholder:       "Applications";
    placeholder-color: @muted;
    text-color:        @fg;
    cursor-color:      @fg;
    cursor-width:      2px;
    background-color:  @bg;
}

listview {
    lines:            12;
    columns:          1;
    scrollbar:        false;
    fixed-height:     true;
    dynamic:          false;
    cycle:            false;
    spacing:          0px;
    background-color: @bg;
}

/* One row per application: muted until selected. The selected row carries a
   bar down the left and a faint wash rather than a full fill, so it marks
   position without repainting the row (wofi's reasoning). */
element {
    padding:          5px 6px;
    border:           0px 0px 0px 3px;
    border-color:     transparent;
    background-color: @bg;
    text-color:       @muted;
}

element normal.normal, element alternate.normal,
element normal.urgent, element alternate.urgent,
element normal.active, element alternate.active {
    background-color: @bg;
    text-color:       @muted;
}

element selected.normal, element selected.urgent, element selected.active {
    background-color: @wash;
    border-color:     @accent;
    text-color:       @fg;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    highlight:        bold;
}

element-icon {
    background-color: transparent;
    size:             0px;
}

/* Widgets this launcher never shows, named so that nothing of the built-in
   theme can return through them. */
scrollbar {
    background-color: @bg;
    handle-color:     @muted;
    handle-width:     4px;
}

message, textbox, error-message {
    background-color: @bg;
    text-color:       @fg;
    border:           0px;
    padding:          6px;
}

mode-switcher, button {
    background-color: @bg;
    text-color:       @muted;
}
