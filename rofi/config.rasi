/* rofi -- stow-managed from ~/Desktop/configs/rofi/config.rasi.
   Edit it here, not at ~/.config/rofi/config.rasi (that is a symlink into
   this repo). Invoked from sway/config as `$menu` ($mod+d, a toggle: a
   second press closes it), defined as `rofi -show drun`; wofi, the launcher
   this replaced on 2026-09-30, keeps $mod+Shift+d as the second one.

   Syntax (man 1 rofi, man 5 rofi-theme): a `configuration { }` block of the
   command-line options in kebab case, then a theme statement. The look lives
   in theme.rasi, loaded whole in place of rofi's built-in theme. Check a
   change with `rofi -config rofi/config.rasi -dump-config` (no display
   needed), which tests/desktop/run.sh runs after edits.

   Deliberately plain, as wofi was: a list you scroll and type into. drun
   only (the .desktop entries, the set GNOME's app grid shows); no icons; no
   per-app actions; no window, run, ssh or combi mode yet -- those are what
   rofi was chosen for over wofi, to be added as they earn a key. */

configuration {
    modes: [ drun ];

    /* Fuzzy: the typed letters in order, in any case, anywhere in an entry's
       name, generic name, command, categories or keywords (drun's default
       fields), so "sysmon" finds System Monitor and "libwri" LibreOffice
       Writer. Chosen 2026-10-01 and kept until it misleads; the way back is
       the one word "normal", which wants each typed word whole ("sys mon").
       Its known stray, measured: a query that names no app can rank a loose
       match first -- "pdf" put Rygel Preferences above Document Viewer, which
       "normal" lists alone. */
    matching: "fuzzy";
    case-sensitive: false;

    /* Rank what matched. With sort off, rofi's default, a query only
       filters, and the matches keep the empty list's A-Z order: "system"
       kept the 18 entries that carry the word anywhere, most through a
       System category, with Alacritty selected and System Monitor 15th,
       below the twelve rows on screen (rendered 2026-10-01). fzf scores the
       query against the name -- word starts and unbroken runs of letters
       count most -- so the app named by the query leads; levenshtein, the
       default method, measures edit distance to the whole name and puts
       short names first (WezTerm above System Monitor for "system"). Only a
       typed query is sorted: the empty list stays A-Z. tests/desktop/run.sh
       pins both lines. */
    sort: true;
    sorting-method: "fzf";

    /* Name only in the list: the default format appends the generic name in
       small italics, which doubles the line's width for nothing. */
    drun-display-format: "{name}";

    /* No per-app actions (they roughly triple the list) and no icons: the
       rest of this desktop is text. */
    drun-show-actions: false;
    show-icons: false;

    /* The empty list is A-Z and stays so, as wofi's does since 2026-09-30:
       with history on, rofi would float the most-launched entries to the top
       and the list would reorder itself with use. */
    disable-history: true;
}

@theme "theme"
